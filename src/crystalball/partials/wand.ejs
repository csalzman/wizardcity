WAND IS IN <span data-text="$wandMode"></span> MODE
<div id="wand-modes" data-signals="{wandMode: 'VIEW'}">
  <button
    data-on:click="
      $wandMode = 'VIEW'
      $isViewOpen = true;
      $isLocationOpen = false;
      $isStructureOpen = false;
    "
    type="checkbox"
  >
    VIEW Mode
  </button>
  <button
    data-on:click="
      $wandMode = 'LOCATION';
      $isViewOpen = false;
      $isLocationOpen = true;
      $isStructureOpen = false;
   "
  >
    LOCATION Mode
  </button>
  <button
    data-on:click="
      $wandMode = 'BUILDING';
      $isViewOpen = false;
      $isLocationOpen = false;
      $isStructureOpen = true;
   "
  >
    STRUCTURE Mode
  </button>
</div>
