<div id="wand-modes" data-signals="{wandMode: 'VIEW'}">
  <button
    data-on:click="
      $wandMode = 'VIEW'
      $isViewOpen = true;
      $isLocationOpen = false;
      $isStructureOpen = false;
    "
    class="wand-button"
    data-class:wand-selected="$wandMode === 'VIEW'"
  >
    VIEW<br />MODE
  </button>
  <button
    data-on:click="
      $wandMode = 'LOCATION';
      $isViewOpen = false;
      $isLocationOpen = true;
      $isStructureOpen = false;
   "
    class="wand-button"
    data-class:wand-selected="$wandMode === 'LOCATION'"
  >
    LOCATION<br />MODE
  </button>
  <button
    data-on:click="
      $wandMode = 'BUILDING';
      $isViewOpen = false;
      $isLocationOpen = false;
      $isStructureOpen = true;
   "
    class="wand-button"
    data-class:wand-selected="$wandMode === 'BUILDING'"
  >
    STRUCTURE<br />MODE
  </button>
</div>
