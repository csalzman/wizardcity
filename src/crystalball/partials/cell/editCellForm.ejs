<div id="edit-cell-form" class="modal">
  <form id="edit-cell-form">
    <div>
      <label for="description">Describe this cell</label> <br />
      <input
        name="description"
        id="description"
        value="<%= cell.description %>"
      />
    </div>
    <div>
      <label for="cell_link">Does this cell link to another cell?</label>
      <br />
      <input
        name="cell_link"
        id="cell_link"
        value="<%= cell.cell_link %>"
        type="number"
      />
    </div>
    <button
      data-on:click="
          @post(`../spellbook/cell/<%= cell.id %>`, {contentType: 'form'});
          $_editCell<%= cell.id %> = false;
        "
    >
      UPDATE
    </button>
  </form>
</div>
