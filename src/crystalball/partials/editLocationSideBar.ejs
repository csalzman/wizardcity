<!-- holds our global data-signals -->
<div
  data-signals="{isLocationOpen: false}"
  id="cell-modal"
  data-show="$isLocationOpen"
  style="display: none"
  class="modal"
>
  <div
    data-effect="if ($isLocationOpen === false && $selected.length > 0) { $selected = []; }"
  ></div>
  <div class="modal-content">
    <h2>WIZARD, WHAT REGION SHALL YOU MAKE</h2>
    <form id="edit-location-form">
      <div data-signals:selected="[]">
        <div>
          <label for="location_name">What is this location's name?</label>
          <br />
          <input name="location_name" id="location_name" />
        </div>
        <div>
          <label for="description">What is this location's description?</label>
          <br />
          <input name="description" id="description" />
        </div>
        <div>
          <label for="color">What color is this location?</label> <br />
          <input name="color" id="color" type="color" />
        </div>
        <!-- TODO: this is not sending selected -->
        <input
          name="selected"
          id="selected"
          data-computed:selstring="$selected.join(', ')"
          data-bind:selstring
          type="hidden"
        />

        <button
          data-on:click="
          @post(`../spellbook/location/`, {contentType: 'form'});
          $selected=[];
        "
          data-indicator:_fetching
          data-attr:disabled="$_fetching"
        >
          UPDATE
        </button>

        <button data-on:click="$selected=[]">Clear Selected</button>
      </div>
    </form>
  </div>
</div>
