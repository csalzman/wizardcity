<div
  data-signals="{
    selected<%= cell.id %>: false
  }"
  data-on:click="
    // Handle if cell is selected or not
    $selected<%= cell.id %> = !$selected<%= cell.id %>;
    // Set if cell is selected for editing
    $cellSelected = <%= JSON.stringify(cell) %>;
    // TODO: move these out to be closer to wand
    $isEditOpen = $wandMode === 'EDIT';
    $isViewOpen = $wandMode === 'VIEW';

    // Find index to see if it's selected or not
    let isSelected = $selected.indexOf(<%= cell.id %>);
    // Not selected, add it. Is selected remove it.
    if ($isLocationOpen && isSelected < 0) { 
      $selected.push(<%= cell.id %>);
    } else {
      $selected.splice(isSelected, 1);
    }

    // Make sure side-bar is updated
    if($isViewOpen) {
      @get(`/spellbook/cell-sidebar/<%= cell.id %>`, { filterSignals: {include: /^cellSelected\./} });
    } 

    // If structure is open we want to update the cell as it is clicked
    if($isStructureOpen) {
      @post(`/spellbook/structure/`, { 
        payload: { 
          cell_id: <%= cell.id %>, 
          structure_image: $selectedStructure 
        }
      });
    }
  "
  id="<%= cell.id %>"
  style='
    background-color: <%= cell.color %>;
    <% if (cell.structure_image) { %>
      background-image: url("../images/<%= cell.structure_image %>.png");
    <% } %>
  '
  data-class:selected="$selected.indexOf(<%= cell.id %>) !== -1"
  class="cell"
  data-indicator:fetching<%= cell.id %>
  data-attr:disabled="$fetching<%= cell.id %>"
>
  <div data-show="$fetching<%= cell.id %>">Loading...</div>
  <div data-show="!$fetching<%= cell.id %>">  <%= cell.id %></div>

</div>
