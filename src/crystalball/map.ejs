<html>
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header') %>
    <div id="map-messages">Map messages</div>
    <%- include('partials/wand') %>
    <div id="map-wrapper">
      <div
        id="map"
        data-init="
          @get('/spellbook/maps/<%- title %>');

          // TODO: how to get map size?
          // @get('/spellbook/map-columns/<%- title %>')
          // document.documentElement.style.setProperty('--map-columns', .x_size);
        "
      >
        Loading initial state...
      </div>
      <div data-signals="{cellSelected: undefined}">
        <%- include('partials/editCellSideBar') %> <%-
        include('partials/viewCellSideBar') %> <%-
        include('partials/editLocationSideBar') %> <%-
        include('partials/editStructureSidebar') %>
      </div>
    </div>
    <div data-text="JSON.stringify($mapSize)"></div>
    <div data-text="JSON.stringify($cellSelected)"></div>
    <%- include('partials/footer') %>
  </body>
</html>
